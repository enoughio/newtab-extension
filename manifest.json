{
  "manifest_version": 3,
  "name": "Widget Drawer Home",
  "version": "1.0.0",
  "description": "New tab home screen with a side widget drawer and a fixed grid that reflows.",
  "chrome_url_overrides": {
    "newtab": "src/newtab.html"
  },
  "background": {
    "service_worker": "src/sw.js"
  },
  "permissions": ["storage", "alarms", "notifications"],
  "host_permissions": [
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
